node_modules/
dist/
*.log

# 本机运行时产生的临时目录(不要提交)
.npm-cache/
.userdata/
.ud/
.verify-out.json

# pip 卡死时留下的临时解包目录
pip-unpack-*/

# Python 虚拟环境与语音识别临时文件(约 2GB,不要提交)
.stt/venv/
.stt/tmp/
.stt/models/
.stt/*.wav
.stt/*.json
.stt/*.log

# 探针测试运行目录
.t/
.dep/

# 测试期间产生的临时 userdata 与诊断输出
.ud-*/
.ls-dump.json
.navpos.json
.scroll-diag.json


# Python 字节码缓存
__pycache__/
*.pyc


# 字幕缓存(本机生成,不要提交)
.stt/cache/
.stt/*.mp4
.stt/*.png
.stt/*.html

